#!/usr/bin/env bash
# mac-maint — Homebrew/App Store/zinit maintenance for every Mac (chezmoi-managed copy of
# ~/Public/.inst-familj/homebrew/maint.sh, the family installer's script). Log: see LOG_FILE.
set -uo pipefail  # Continue on error (no -e)

# Ask for admin password up front (before logging starts)
sudo -v

# Set up logging (XDG state dir; this script lives in ~/.local/bin via chezmoi)
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/mac-maint"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/maint.log"
exec > >(tee "$LOG_FILE") 2>&1
exec 3>&1              # Duplicate stdout to fd 3
BASH_XTRACEFD=3        # Send command traces to fd 3 (stdout/main log)
set -x

# Log return codes after each command
trap 'echo "==> Exit code: $?"' DEBUG

# Every maintenance step goes through `run`: it remembers the ones that failed for the summary at the end
# (brew-halsa A13: `set -uo pipefail` without -e continues past errors, so a crashed step must not vanish in the log)
failed_steps=()
run() {
  "$@"
  local rc=$?
  [ "$rc" -ne 0 ] && failed_steps+=("$* (exit $rc)")
  return "$rc"
}

# Check if zinit is installed, if installed then update zinit plugins
if command -v zinit &>/dev/null; then
  echo "Updating zinit plugins..."
  run zinit self-update
  run zinit update --all --parallel
fi

# Start maintenance
run brew update

# Intel Macs (Tier 3 since macOS 26): Homebrew ships no x86_64 bottles, so every outdated formula would
# compile from source for hours. Pin the list in pin-x86_64.txt first; only security-exposed formulae stay
# unpinned (brew-halsa A3, 2026-09-08). Apple Silicon Macs skip this.
pin_list="${XDG_CONFIG_HOME:-$HOME/.config}/mac-maint/pin-x86_64.txt"
if [ "$(uname -m)" = "x86_64" ] && [ -f "$pin_list" ]; then
  to_pin=()
  while IFS= read -r formula; do to_pin+=("$formula"); done < <(comm -12 <(grep -v '^#' "$pin_list" | grep -v '^$' | sort) <(brew list --formula -1 | sort))
  [ "${#to_pin[@]}" -gt 0 ] && run brew pin "${to_pin[@]}"  # already-pinned formulae are a no-op
  echo "==> Intel: $(brew list --pinned | wc -l | tr -d ' ') formulae pinned, brew upgrade only builds the rest"
fi

run brew upgrade

# Upgrade every cask, including auto-updating ones (1Password, VS Code, Syncthing …).
# Replaces `brew cu` (buo/cask-upgrade), which broke against Homebrew 6.0.22 — brew-halsa A13, 2026-09-07.
run brew upgrade --cask --greedy

# App Store apps
run mas upgrade

# Clean up: remove unused deps, stale downloads, and check for problems
run brew autoremove
run brew cleanup
run brew doctor || true  # warnings (tap bugs, disabled casks) must not turn a clean maintenance run into a failed one (2026-09-07)

# Summary: every step that returned non-zero (brew doctor's warnings show up here too — read them, they are not errors)
set +x
trap - DEBUG
if [ "${#failed_steps[@]}" -eq 0 ]; then
  echo "==> mac-maint: all steps OK"
else
  printf '==> WARNING: %s\n' "${failed_steps[@]}"
fi
